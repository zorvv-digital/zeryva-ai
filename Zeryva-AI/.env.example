APP_NAME="Zeryva AI Platform"
ENVIRONMENT="development"
DATABASE_URL="sqlite+aiosqlite:///./zeryva_ai.db"
META_WHATSAPP_VERIFY_TOKEN="zeryva_verify_token_default"
META_WHATSAPP_APP_SECRET="your_meta_app_secret_here"
SECRET_KEY="zeryva-super-secret-key-change-in-production-32bytes!"

# LLM configuration (select provider: nim, openai, gemini, anthropic)
LLM_PROVIDER=gemini

NIM_API_KEY=""
NIM_MODEL=meta/llama-3.2-3b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_API_KEY=""
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash

# Optional Default Provider Keys
OPENAI_API_KEY=""

# WhatsApp integration settings
